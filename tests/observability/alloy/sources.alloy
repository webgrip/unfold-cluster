local.file_match "pod_logs" {
	path_targets = [{
		"__path__" = sys.env("FIXTURE_DIR") + "/pod.log",
		namespace  = "zot",
		pod        = "zot-0",
		container  = "zot",
		node       = "unfold-app-1",
		app        = "zot",
	}]
}

loki.source.file "pod_logs" {
	targets       = local.file_match.pod_logs.targets
	forward_to    = [loki.process.pod.receiver]
	tail_from_end = false
}

local.file_match "kube_audit" {
	path_targets = [{"__path__" = sys.env("FIXTURE_DIR") + "/audit.log"}]
}

loki.source.file "kube_audit" {
	targets       = local.file_match.kube_audit.targets
