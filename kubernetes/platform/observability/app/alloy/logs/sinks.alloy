loki.write "logs" {
	endpoint {
		url = "http://vlsingle-logs.observability.svc.cluster.local:9428/insert/loki/api/v1/push?_stream_fields=cluster,source,node,namespace,pod,container,talos_service&_msg_field=message"
	}
	external_labels = {
		cluster = "unfold",
	}
}

loki.write "audit" {
	endpoint {
		url = "http://vlsingle-audit.observability.svc.cluster.local:9428/insert/loki/api/v1/push?_stream_fields=cluster,job,node&_msg_field=requestURI"
	}
	external_labels = {
		cluster = "unfold",
	}
}

loki.write "homelab_logs" {
	endpoint {
		url = "http://unfold-gateway.webgrip.dev:8427/insert/loki/api/v1/push?_stream_fields=cluster,source,node,namespace,pod,container,talos_service&_msg_field=message"
	}
	external_labels = {
		cluster = "unfold",
	}
}

loki.write "homelab_audit" {
	endpoint {
		url = "http://unfold-gateway.webgrip.dev:8427/audit/insert/loki/api/v1/push?_stream_fields=cluster,job,node&_msg_field=requestURI"
	}
	external_labels = {
		cluster = "unfold",
	}
}
