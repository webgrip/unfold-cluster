#cloud-config
package_update: true
packages:
  - curl
users:
  - default
  - name: admin
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}
ssh_pwauth: false
disable_root: true
write_files:
  - path: /etc/headscale/acl.hujson
    permissions: "0644"
    content: |
      ${indent(6, acl)}
  - path: /etc/headscale/config.yaml
    permissions: "0644"
    content: |
      server_url: https://${hostname}
      listen_addr: 0.0.0.0:443
      metrics_listen_addr: 127.0.0.1:9090
      grpc_listen_addr: 127.0.0.1:50443
      grpc_allow_insecure: false
      noise:
        private_key_path: /var/lib/headscale/noise_private.key
      prefixes:
        v4: 100.64.0.0/10
        v6: fd7a:115c:a1e0::/48
        allocation: sequential
      derp:
        server:
          enabled: true
          region_id: 999
          region_code: unfold
          region_name: Unfold embedded DERP
          verify_clients: true
          stun_listen_addr: 0.0.0.0:3478
          private_key_path: /var/lib/headscale/derp_server_private.key
          automatically_add_embedded_derp_region: true
          ipv4: ${ipv4}
        urls: []
        paths: []
        auto_update_enabled: false
      disable_check_updates: true
      database:
        type: sqlite
        sqlite:
          path: /var/lib/headscale/db.sqlite
          write_ahead_log: true
      acme_url: https://acme-v02.api.letsencrypt.org/directory
      acme_email: ${acme_email}
      tls_letsencrypt_hostname: ${hostname}
      tls_letsencrypt_cache_dir: /var/lib/headscale/cache
      tls_letsencrypt_challenge_type: HTTP-01
      tls_letsencrypt_listen: ":http"
      log:
        level: info
        format: text
      policy:
        mode: file
        path: /etc/headscale/acl.hujson
      dns:
        magic_dns: true
        base_domain: tailnet.unfold.internal
        override_local_dns: false
        nameservers:
          global:
            - 1.1.1.1
            - 1.0.0.1
      unix_socket: /var/run/headscale/headscale.sock
      unix_socket_permission: "0770"
      logtail:
        enabled: false
runcmd:
  - [sh, -c, "cd /tmp && curl -fsSLo headscale.deb https://github.com/juanfont/headscale/releases/download/v${headscale_version}/headscale_${headscale_version}_linux_amd64.deb"]
  - [sh, -c, "echo '${headscale_sha256}  /tmp/headscale.deb' | sha256sum -c -"]
  - [sh, -c, "DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confold /tmp/headscale.deb"]
  - [sh, -c, "mkdir -p /etc/systemd/system/headscale.service.d && printf '[Service]\\nAmbientCapabilities=CAP_NET_BIND_SERVICE\\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE\\nRestart=always\\nRestartSec=15\\n' > /etc/systemd/system/headscale.service.d/override.conf"]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, headscale]
