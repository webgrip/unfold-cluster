#cloud-config
package_update: true
packages:
  - curl
  - unattended-upgrades
  - jq
  - podman
users:
  - default
  - name: admin
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}
  - name: tofu
    shell: /bin/sh
    lock_passwd: true
    ssh_authorized_keys:
      - 'restrict,command="set -f; exec sudo -n /usr/local/sbin/unfold-tailnet-key $SSH_ORIGINAL_COMMAND" ${tofu_ssh_public_key}'
ssh_pwauth: false
disable_root: true
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
ssh_keys:
  ed25519_private: |
    ${indent(4, host_key_private)}
  ed25519_public: ${host_key_public}
write_files:
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/apt/apt.conf.d/52unattended-upgrades-reboot
    permissions: "0644"
    content: |
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "04:30";
  - path: /etc/systemd/system/apt-daily-upgrade.timer.d/override.conf
    permissions: "0644"
    content: |
      [Timer]
      OnCalendar=
      OnCalendar=*-*-* 04:00
      RandomizedDelaySec=0
  - path: /etc/unfold-tailnet/settings.env
    permissions: "0644"
    content: |
      NODE_USER=${node_user}
      ADMIN_USER=${admin_user}
      CONTROL_PLANE_TAG=tag:cp
      CONTROL_PLANE_KEY_LIFETIME_HOURS=2160
      RENEW_WHEN_DAYS_LEFT=45
      WORKER_KEY_LIFETIME_HOURS=24
      STATE_DIR=/var/lib/unfold-tailnet
      HEALTH_URL=https://${hostname}/health
      HEALTH_CONNECT_TO=${hostname}:443:127.0.0.1:443
  - path: /usr/local/sbin/unfold-tailnet-key
    permissions: "0755"
    content: |
      ${indent(6, tailnet_key_script)}
  - path: /etc/sudoers.d/unfold-tailnet-key
    permissions: "0440"
    content: |
      ${indent(6, tailnet_key_sudoers)}
  - path: /etc/systemd/system/unfold-tailnet-key.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Keep the control planes' Headscale pre-auth key valid
      After=headscale.service
      Requires=headscale.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/unfold-tailnet-key renew
  - path: /etc/systemd/system/unfold-tailnet-key.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Renew the control planes' Headscale pre-auth key daily

      [Timer]
      OnBootSec=10min
      OnCalendar=daily
      RandomizedDelaySec=1h
      Persistent=true

      [Install]
      WantedBy=timers.target
  - path: /etc/unfold-kms/master.key
    permissions: "0400"
    owner: root:root
    encoding: b64
    content: "${kms_master_key_b64}"
  - path: /usr/local/sbin/unfold-kms-cert
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      cache=/var/lib/headscale/cache
      target=/etc/unfold-kms/tls.pem
      for name in "${hostname}" "${hostname}+rsa"; do
        source="$cache/$name"
        [ -s "$source" ] && grep -q 'BEGIN CERTIFICATE' "$source" || continue
        if cmp -s "$source" "$target"; then
          exit 0
        fi
        install -m 0400 -o root -g root "$source" "$target.new"
        mv "$target.new" "$target"
        [ "$${1:-}" = reload ] && systemctl try-restart unfold-kms.service
        exit 0
      done
      echo "unfold-kms-cert: Headscale has no certificate for ${hostname} yet" >&2
      exit 1
  - path: /etc/systemd/system/unfold-kms.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Talos disk-encryption KMS, sealing the nodes' LUKS2 keys
      After=network-online.target headscale.service
      Wants=network-online.target
      StartLimitIntervalSec=0

      [Service]
      ExecStartPre=/usr/local/sbin/unfold-kms-cert
      ExecStartPre=-/usr/bin/podman rm --force --ignore unfold-kms
      ExecStart=/usr/bin/podman run --rm --name unfold-kms --network host --read-only --cap-drop all --security-opt no-new-privileges --pull missing --volume /etc/unfold-kms:/etc/unfold-kms:ro ${kms_image} --kms-api-endpoint :${kms_port} --key-path /etc/unfold-kms/master.key --tls-enable --tls-cert-path /etc/unfold-kms/tls.pem --tls-key-path /etc/unfold-kms/tls.pem
      ExecStop=/usr/bin/podman stop --time 10 unfold-kms
      Restart=always
      RestartSec=30

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/unfold-kms-cert.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Hand Headscale's renewed certificate to the disk KMS

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/unfold-kms-cert reload
  - path: /etc/systemd/system/unfold-kms-cert.path
    permissions: "0644"
    content: |
      [Unit]
      Description=Watch Headscale's certificate cache for a renewal

      [Path]
      PathChanged=/var/lib/headscale/cache
      Unit=unfold-kms-cert.service

      [Install]
      WantedBy=paths.target
  - path: /etc/headscale/acl.hujson
    permissions: "0644"
    content: |
      ${indent(6, acl)}
  - path: /etc/headscale/config.yaml
    permissions: "0644"
    content: |
      ${indent(6, config)}
  - path: ${oidc_client_secret_path}
    permissions: "0640"
    content: ""
runcmd:
  - [sh, -c, "cd /tmp && curl -fsSLo headscale.deb https://github.com/juanfont/headscale/releases/download/v${headscale_version}/headscale_${headscale_version}_linux_amd64.deb"]
  - [sh, -c, "echo '${headscale_sha256}  /tmp/headscale.deb' | sha256sum -c -"]
  - [sh, -c, "DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confold /tmp/headscale.deb"]
  - [sh, -c, "mkdir -p /etc/systemd/system/headscale.service.d && printf '[Service]\\nAmbientCapabilities=CAP_NET_BIND_SERVICE\\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE\\nRestart=always\\nRestartSec=15\\n' > /etc/systemd/system/headscale.service.d/override.conf"]
  - [systemctl, daemon-reload]
  - [sh, -c, "for attempt in $(seq 180); do resolvectl query --cache=no --legend=no -4 ${hostname} 2>/dev/null | grep -qwF '${ipv4}' && break; sleep 10; done"]
  - [chgrp, headscale, ${oidc_client_secret_path}]
  - [systemctl, enable, --now, headscale]
  - [systemctl, enable, --now, unfold-tailnet-key.timer]
  - [/usr/local/sbin/unfold-tailnet-key, host, apply, "${tailscale_version}", "${tailscale_sha256}"]
  - [sh, -c, "for attempt in $(seq 30); do podman pull ${kms_image} && break; sleep 10; done"]
  - [systemctl, enable, --now, unfold-kms-cert.path, unfold-kms.service]
