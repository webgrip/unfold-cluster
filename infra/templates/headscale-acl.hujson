{
  "groups": {
    "group:admin": ["${admin_user}@"]
  },
  "tagOwners": {
    "tag:cp": ["group:admin"],
    "tag:node": ["group:admin"],
    "tag:homelab-gateway": ["group:admin"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["group:admin"],
      "dst": ["*:*"]
    },
    {
      "action": "accept",
      "src": ["tag:cp", "tag:node"],
      "dst": ["tag:homelab-gateway:8200,8427"]
    },
    {
      "action": "accept",
      "src": ["tag:node"],
      "dst": ["tag:homelab-gateway:9150"]
    }
  ],
  "autoApprovers": {
    "routes": {
      "${node_route}": ["tag:cp"]
    }
  }
}
