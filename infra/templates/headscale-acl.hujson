{
  "groups": {
    "group:admin": ["${admin_user}@"]
  },
  "tagOwners": {
    "tag:cp": ["group:admin"],
%{ for tag in worker_tags ~}
    "${tag}": ["group:admin"],
%{ endfor ~}
    "tag:homelab-gateway": ["group:admin"],
    "tag:headscale": ["group:admin"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["autogroup:member"],
      "dst": [
        "autogroup:member:*",
        "tag:cp:*",
%{ for tag in worker_tags ~}
        "${tag}:*",
%{ endfor ~}
        "tag:headscale:*",
        "tag:homelab-gateway:8200,8427,9150",
        "${node_route}:*"
      ]
    },
    {
      "action": "accept",
      "src": ["tag:cp"],
      "dst": ["tag:homelab-gateway:8200"]
    },
    {
      "action": "accept",
      "src": ${jsonencode(concat(["tag:cp"], worker_tags))},
      "dst": ["tag:homelab-gateway:8427"]
    },
    {
      "action": "accept",
      "src": ${jsonencode(ci_job_count_sources)},
      "dst": ["tag:homelab-gateway:9150"]
    },
    {
      "action": "accept",
      "src": ["tag:headscale"],
      "dst": ["tag:homelab-gateway:443"]
    },
    {
      "action": "accept",
      "src": ["tag:hub"],
      "dst": ["tag:homelab-gateway:443"]
    },
    {
      "action": "accept",
      "src": ["tag:homelab-gateway"],
      "dst": ["${ops_gateway}/32:443"]
    }
  ],
  "autoApprovers": {
    "routes": {
      "${node_route}": ["tag:cp"]
    }
  }
}
