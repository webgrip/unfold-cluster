{
  "groups": {
    "group:admin": ["${admin_user}@"]
  },
  "tagOwners": {
    "tag:cp": ["group:admin"],
    "tag:node": ["group:admin"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["group:admin"],
      "dst": ["*:*"]
    }
  ],
  "autoApprovers": {
    "routes": {
      "${node_route}": ["tag:cp"]
    }
  }
}
